# Configuración del Servidor
PORT=4000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173,https://horarios.sena.edu.co

# Base de Datos PostgreSQL
DATABASE_URL=postgresql://usuario_sena:contrasena_segura@localhost:5432/sena_horarios_db

# Seguridad JWT (Generar una clave de al menos 64 caracteres)
JWT_SECRET=sena_jwt_super_secret_production_key_2026_academico_secure_token_abc123!
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=sena_refresh_secret_production_2026_xyz789!
JWT_REFRESH_EXPIRES_IN=7d

# Configuración de Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
